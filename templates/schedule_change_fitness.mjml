<mjml lang="de">
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text css-class="sve-text" font-size="15px" line-height="1.6" color="#333" padding="10px 48px" />
    </mj-attributes>
    <mj-preview>Termin&auml;nderung bei Deinem gebuchten Kurs.</mj-preview>
    <mj-raw>{{> _head_meta}}</mj-raw>
  </mj-head>
  <mj-body background-color="#fafafa" css-class="sve-body">
    {{> _branding_header}}

    <mj-section css-class="sve-section" padding="0">
      <mj-column padding="0">
        <mj-text>
          <p>Hallo {{firstname}},</p>

          <p>bei deinem gebuchten Kurs <strong>&bdquo;{{name}}&rdquo;</strong> gibt es eine Termin&auml;nderung.</p>

          <p>Die folgenden Kurstermine entfallen:</p>
          <p style="white-space: pre-line;"><strong>{{removed_dates}}</strong></p>

          <p>Die neuen Kurstermine sind:</p>
          <p style="white-space: pre-line;"><strong>{{new_dates}}</strong></p>

          <p>Wir w&uuml;nschen Dir weiterhin viel Spa&szlig; beim Kurs.</p>

          <p>Herzliche Gr&uuml;&szlig;e<br />Team Fitness@SVE</p>
        </mj-text>
      </mj-column>
    </mj-section>

    {{> _branding_footer}}
  </mj-body>
</mjml>
