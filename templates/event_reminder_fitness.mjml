<mjml lang="de">
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text css-class="sve-text" font-size="15px" line-height="1.6" color="#333" padding="10px 48px" />
    </mj-attributes>
    <mj-preview>Erinnerung: Dein SVE-Kurs startet bald.</mj-preview>
    <mj-raw>{{> _head_meta}}</mj-raw>
  </mj-head>
  <mj-body background-color="#fafafa" css-class="sve-body">
    {{> _branding_header}}

    <mj-section css-class="sve-section" padding="0">
      <mj-column padding="0">
        <mj-text>
          <p>Hallo {{firstname}},</p>

          <p>Du hast einen Platz in unserem SVE-Kurs <strong>&bdquo;{{name}}&rdquo;</strong> gebucht.<br />
          Kommende Woche geht es los und wir m&ouml;chten Dir letzte Infos geben:</p>

          <p>Der Kurs beginnt am <strong>{{start_date}}</strong> um <strong>{{start_time}}</strong> und findet hier statt:<br />
          <strong>{{location}}</strong></p>

          <p>Wir freuen uns auf Deine Teilnahme und w&uuml;nschen Dir viel Freude beim Kurs.</p>

          <p>Herzliche Gr&uuml;&szlig;e<br />Team Fitness@SVE</p>
        </mj-text>
      </mj-column>
    </mj-section>

    {{> _branding_footer}}
  </mj-body>
</mjml>
